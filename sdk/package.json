{
  "name": "@sleep2agi/commhub-sdk",
  "version": "0.1.0",
  "description": "CommHub communication SDK — SSE real-time messaging for AI Agent networks",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "module": "dist/index.mjs",
  "exports": {
    ".": {
      "import": "./dist/index.mjs",
      "require": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist",
    "index.ts"
  ],
  "scripts": {
    "build": "bun build index.ts --outdir dist --target node && tsc --emitDeclarationOnly --declaration --outDir dist",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "commhub",
    "agent",
    "ai",
    "sse",
    "mcp",
    "claude",
    "telegram",
    "orchestration"
  ],
  "author": "sleep2agi",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/sleep2agi/agent-comm-hub",
    "directory": "sdk"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "devDependencies": {
    "typescript": "^5.0.0"
  }
}
