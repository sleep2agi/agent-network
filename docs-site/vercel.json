{
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/desktop/update/latest.json",
      "destination": "/api/desktop-update-latest"
    }
  ],
  "headers": [
    {
      "source": "/desktop/update/latest.json",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, max-age=0"
        }
      ]
    }
  ]
}
