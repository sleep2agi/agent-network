# ─────────────────────────────────────────────────────────────
# Science Team Demo (issue #51) — .env example
# Copy to `.env` and fill in your values before `docker compose up`.
# ─────────────────────────────────────────────────────────────

# ── 书生 (Intern AI Lab) API key ──
# 拿 key: https://chat.intern-ai.org.cn/
# Used as ANTHROPIC_AUTH_TOKEN against the Anthropic-compatible endpoint
INTERN_API_KEY=sk-replace-me

# ── CommHub auth (default OK; v0.8 起仅 /api/* 只读软废弃) ──
COMMHUB_AUTH_TOKEN=science-team-token

# ── Research direction (注入到每个 agent 的 system prompt) ──
RESEARCH_TOPIC=全面 AI 综述

# ── CommHub host port (容器内固定 9200，宿主机映射) ──
# Default 9200; 若本地已占用改成 9210/9220/etc.
HUB_PORT=9200
