// RFC-030 Wave 1A P0.2 Commit 2 corrective round 2 (副指挥 0bd525d0
// P1-3). Positive baseline: a CORRECT abort implementation MUST
// typecheck clean. The negative harness runs tsc on THIS file and
// asserts EXIT 0 — a green outcome for the positive fixture is a
// sanity check that the harness itself is not false-red.
//
// Additionally, the negative harness runs a "correct abort + one
// unrelated TS error" variant of this fixture and asserts the
// harness turns RED — so that a random TS2420 elsewhere in the
// project cannot pass off as an abort-negative.

import type { UpstreamTransport } from "../uds-server";
import type {
  JsonRpcNotificationFrame,
  JsonRpcRequestFrame,
  JsonRpcResponseFrame,
} from "../protocol";

// eslint-disable-next-line @typescript-eslint/no-unused-vars
class GoodTransport implements UpstreamTransport {
  async writeFrame(_f: JsonRpcRequestFrame | JsonRpcResponseFrame | JsonRpcNotificationFrame): Promise<void> {}
  onFrame(_h: (raw: unknown) => void): () => void { return () => {}; }
  onClose(_h: () => void): () => void { return () => {}; }
  async close(): Promise<void> {}
  abort: () => Promise<void> = async () => {};
}

export const _ = { GoodTransport };
