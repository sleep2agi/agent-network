// RFC-030 Wave 1A P0.2 Commit 2 corrective (副指挥 d53209eb #5)
// TYPECHECK-NEGATIVE FIXTURE — this file is INTENTIONALLY excluded
// from the gateway tsconfig. The harness at
// `scripts/rfc030-async-abort-typecheck-negative.mjs` runs
// `tsc --noEmit` on it and asserts a non-zero exit + expected
// error code so any regression that would let an `async abort()`
// slip past the type system fails loudly.
//
// The point of this file is to attempt the following, which MUST
// be rejected by `tsc --strict`:
//
//   class BadTransport implements UpstreamTransport {
//     ...
//     async abort() { throw new Error("boom"); }   // <-- illegal
//   }
//
// `async` methods return `Promise<T>`; the `abort()` return type is
// the branded `SyncAbortAcknowledgement` (`typeof SYNC_ABORT`).
// `Promise<SyncAbortAcknowledgement>` is NOT assignable to
// `SyncAbortAcknowledgement`, so tsc emits an error.

import { SYNC_ABORT, type SyncAbortAcknowledgement, type UpstreamTransport } from "../uds-server";
import type {
  JsonRpcNotificationFrame,
  JsonRpcRequestFrame,
  JsonRpcResponseFrame,
} from "../protocol";

// One valid impl (sanity — must NOT surface an error).
class GoodTransport implements UpstreamTransport {
  async writeFrame(_f: JsonRpcRequestFrame | JsonRpcResponseFrame | JsonRpcNotificationFrame): Promise<void> {}
  onFrame(_h: (raw: unknown) => void): () => void { return () => {}; }
  onClose(_h: () => void): () => void { return () => {}; }
  async close(): Promise<void> {}
  abort(): SyncAbortAcknowledgement { return SYNC_ABORT; }
}

// The bad impls below MUST fail typecheck.

class BadAsyncAbort implements UpstreamTransport {
  async writeFrame(_f: JsonRpcRequestFrame | JsonRpcResponseFrame | JsonRpcNotificationFrame): Promise<void> {}
  onFrame(_h: (raw: unknown) => void): () => void { return () => {}; }
  onClose(_h: () => void): () => void { return () => {}; }
  async close(): Promise<void> {}
  // TS2416: async → Promise<SyncAbortAcknowledgement>, NOT
  // assignable to SyncAbortAcknowledgement.
  async abort(): Promise<SyncAbortAcknowledgement> { return SYNC_ABORT; }
}

class BadVoidAbort implements UpstreamTransport {
  async writeFrame(_f: JsonRpcRequestFrame | JsonRpcResponseFrame | JsonRpcNotificationFrame): Promise<void> {}
  onFrame(_h: (raw: unknown) => void): () => void { return () => {}; }
  onClose(_h: () => void): () => void { return () => {}; }
  async close(): Promise<void> {}
  // TS: `void` is not assignable to `SyncAbortAcknowledgement`.
  abort(): void {}
}

class BadNumberAbort implements UpstreamTransport {
  async writeFrame(_f: JsonRpcRequestFrame | JsonRpcResponseFrame | JsonRpcNotificationFrame): Promise<void> {}
  onFrame(_h: (raw: unknown) => void): () => void { return () => {}; }
  onClose(_h: () => void): () => void { return () => {}; }
  async close(): Promise<void> {}
  // Any value that isn't SYNC_ABORT symbol should fail.
  abort(): number { return 0; }
}

// Force references so tsc doesn't dead-code them.
export const _ = { GoodTransport, BadAsyncAbort, BadVoidAbort, BadNumberAbort };
