// RFC-030 Wave 1A P0.2 Commit 2 corrective round 10 (副指挥
// 9a9a198d). Type-negative fixture: non-async callback that
// returns a Promise. Must fail `tsc --strict` — the callback
// signature is `(v: unknown) => undefined`; a Promise-returning
// callback is not assignable.

import { safeAdoptConsume } from "../safe-adopt";

// eslint-disable-next-line @typescript-eslint/no-unused-vars
const use = (): void => {
  // TS2345: () => Promise<void> is not assignable to
  //         (v: unknown) => undefined.
  safeAdoptConsume(Promise.resolve(), (_v) => Promise.resolve());
};
