// RFC-030 Wave 1A P0.2 Commit 2 corrective round 10 (副指挥
// 9a9a198d). Type-negative fixture: `async` callback passed to
// `safeAdoptConsume`. Must fail `tsc --strict` because `async`
// callbacks return `Promise<void>`, which is not assignable to
// `undefined`.
//
// Imports the PRODUCTION `safeAdoptConsume` (not a redeclared
// copy). The harness's meta-sanity asserts no local
// redeclaration.

import { safeAdoptConsume } from "../safe-adopt";

// eslint-disable-next-line @typescript-eslint/no-unused-vars
const use = (): void => {
  // TS2345: async callback returns Promise<void>, not undefined.
  safeAdoptConsume(Promise.resolve(), async (_v) => {});
};
