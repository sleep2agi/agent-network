{
  "name": "@sleep2agi/agent-node",
  "version": "2.5.0-preview.4",
  "description": "AI Agent runtime for CommHub networks. Supports 4 runtimes: Claude Code CLI, Claude Agent SDK, Codex SDK, and Grok Build ACP.",
  "bin": {
    "agent-node": "dist/cli.js"
  },
  "type": "module",
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "bun build src/cli.ts --outdir dist --entry-naming cli.js --target node --minify --external @anthropic-ai/claude-agent-sdk --external '@anthropic-ai/claude-agent-sdk-*' --external @openai/codex-sdk",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "agent",
    "ai",
    "commhub",
    "claude",
    "claude-code",
    "codex",
    "gpt5",
    "grok",
    "xai",
    "acp",
    "sdk",
    "minimax",
    "mimo",
    "runtime",
    "node",
    "anthropic"
  ],
  "author": "sleep2agi",
  "license": "Apache-2.0",
  "homepage": "https://anet.sh",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sleep2agi/agent-network.git",
    "directory": "agent-node"
  },
  "publishConfig": {
    "access": "public"
  },
  "bugs": {
    "url": "https://github.com/sleep2agi/agent-network/issues"
  },
  "engines": {
    "node": ">=22.4.0"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.2.140",
    "undici": "^8.5.0",
    "zod": "^4.4.3"
  },
  "optionalDependencies": {
    "@openai/codex": "^0.133.0",
    "@openai/codex-sdk": "^0.133.0"
  }
}
