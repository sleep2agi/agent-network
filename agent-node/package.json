{
  "name": "@sleep2agi/agent-node",
  "version": "2.5.0-preview.16",
  "description": "AI Agent runtime for CommHub networks. Supports 4 runtimes: Claude Code CLI, Claude Agent SDK, Codex SDK, and Grok Build ACP.",
  "bin": {
    "agent-node": "dist/cli.js"
  },
  "type": "module",
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "bun build src/cli.ts --outdir dist --entry-naming cli.js --target node --minify --external @anthropic-ai/claude-agent-sdk --external '@anthropic-ai/claude-agent-sdk-*' --external @openai/codex-sdk",
    "prepublishOnly": "npm run build",
    "build:rfc030-integration": "bun build --target=node --format=esm --outfile=dist/rfc030-integration.mjs src/runtime/codex-policy-gateway/integration-entry.ts",
    "test:rfc030-node-integration": "npm run build:rfc030-integration && node scripts/rfc030-node-integration.mjs",
    "test:rfc030-real-cli-smoke": "npm run build:rfc030-integration && node scripts/rfc030-real-cli-e2e.mjs",
    "typecheck:rfc030": "tsc --project src/runtime/codex-policy-gateway/tsconfig.json",
    "typecheck:rfc030-async-abort-negative": "node scripts/rfc030-async-abort-typecheck-negative.mjs"
  },
  "keywords": [
    "agent",
    "ai",
    "commhub",
    "claude",
    "claude-code",
    "codex",
    "gpt5",
    "grok",
    "xai",
    "acp",
    "sdk",
    "minimax",
    "mimo",
    "runtime",
    "node",
    "anthropic"
  ],
  "author": "sleep2agi",
  "license": "Apache-2.0",
  "homepage": "https://anet.sh",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sleep2agi/agent-network.git",
    "directory": "agent-node"
  },
  "publishConfig": {
    "access": "public"
  },
  "bugs": {
    "url": "https://github.com/sleep2agi/agent-network/issues"
  },
  "engines": {
    "node": ">=18.17.0"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.2.140",
    "undici": "^6.27.0",
    "zod": "^4.4.3",
    "ws": "8.21.0"
  },
  "optionalDependencies": {
    "@openai/codex": "^0.133.0",
    "@openai/codex-sdk": "^0.133.0"
  },
  "devDependencies": {
    "@types/node": "20",
    "@types/ws": "8.18.1",
    "typescript": "5.5.4"
  }
}
