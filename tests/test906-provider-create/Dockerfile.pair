# TEST-ONLY version pairing, separate from the unchanged native-session suite.
FROM oven/bun:1.3.14@sha256:e10577f0db68676a7024391c6e5cb4b879ebd17188ab750cf10024a6d700e5c4
USER root
RUN install -d -m 0755 /run/user && install -d -m 0700 -o bun -g bun /run/user/1000
WORKDIR /repo
COPY agent-network/package.json agent-network/package-lock.json ./agent-network/
COPY agent-network/src/ ./agent-network/src/
COPY agent-node/package.json agent-node/package-lock.json ./agent-node/
COPY agent-node/src/package-version-consistency.test.ts ./agent-node/src/package-version-consistency.test.ts
ARG SOURCE_COMMIT
ENV SOURCE_COMMIT=${SOURCE_COMMIT}
USER bun
CMD ["sh", "-c", "test -n \"$SOURCE_COMMIT\" && test \"$SOURCE_COMMIT\" = \"$EXPECTED_SOURCE_COMMIT\" && bun test --bail agent-network/src/opencode-agent-node-pair.test.ts agent-network/src/package-version-consistency.test.ts agent-node/src/package-version-consistency.test.ts"]
