# Isolated integration only; both local inputs are pinned in the report.
# This does not build or publish a native desktop release.
ARG CLIENT_IMAGE=anet-app-v2-options:ui-1ef
ARG NATIVE_IMAGE=anet-test829:native-create-proof-504b
FROM ${CLIENT_IMAGE} AS client
FROM ${NATIVE_IMAGE}
RUN apt-get update && apt-get install -y --no-install-recommends chromium && rm -rf /var/lib/apt/lists/*
RUN apt-get update && apt-get install -y --no-install-recommends fonts-noto-cjk && rm -rf /var/lib/apt/lists/*
COPY --from=client /qa-tools /qa-tools
COPY --from=client /web-v2 /client-web
COPY --from=client /app/tests/test-layout-sweep/harness.mjs /client-plumbing/harness.mjs
COPY server /workspace/server
COPY agent-network /workspace/agent-network
COPY agent-node /opt/node_modules/@sleep2agi/agent-node
RUN chmod 644 /opt/node_modules/@sleep2agi/agent-node/package.json
COPY tests/test829-opencode-create /workspace/tests/test829-opencode-create
ARG SOURCE_COMMIT
ENV SOURCE_COMMIT=$SOURCE_COMMIT OVERLAY_SOURCE_COMMIT=$SOURCE_COMMIT
ENV TEST829_CLIENT_DRIVER=/workspace/tests/test829-opencode-create/native-client.mjs
ENV CLIENT_SOURCE_COMMIT=1ef7f77ee620a758290e75dbb449a58b6aa1fd2c
ENV PLAYWRIGHT_MODULE=/qa-tools/node_modules/playwright/index.mjs
