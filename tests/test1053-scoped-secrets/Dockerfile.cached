# Optional local dependency cache. The portable recipe is Dockerfile.
FROM anet-test1045-http-provider-core
USER root
COPY . /candidate
WORKDIR /candidate
RUN ln -s /work/agent-network/node_modules /candidate/agent-network/node_modules && ln -s /work/agent-node/node_modules /candidate/agent-node/node_modules && ln -s /work/server/node_modules /candidate/server/node_modules && ln -s /candidate/server/node_modules /candidate/node_modules
ENV HOME=/tmp/scoped-secrets-test COMMHUB_DB=/tmp/scoped-secrets1053.db ANET_DAEMON_ALLOW_ENV_BIN=1 ANET_BIN_ABS=/candidate/agent-network/dist/bin/anet.cjs
RUN bun build agent-network/bin/cli.ts --target=node --outfile=/candidate/agent-network/dist/bin/cli.js --external @sleep2agi/commhub-server --external bun:sqlite --external '../../server/*' && cp agent-network/bin/anet.cjs agent-network/dist/bin/anet.cjs && chmod 755 agent-network/dist/bin/anet.cjs
USER runner
CMD ["sh", "-c", "bun test --bail agent-network/src/scoped-secrets.test.ts && bun test --bail tests/test1053-scoped-secrets/hub-runtime.test.ts"]
