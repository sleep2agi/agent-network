+const fs = require("fs");
+const path = require("path");
+
 export async function uploadHandler(req: Request): Promise<Response> {
-  return new Response("upload disabled");
+  const filename = new URL(req.url).searchParams.get("name") || "anon.bin";
+  const body = await req.text();
+  // save under uploads/
+  const target = path.join(__dirname, "..", "uploads", filename);
+  fs.writeFileSync(target, body);
+  return Response.json({ saved: target });
 }

