diff --git a/server/src/handlers/users.ts b/server/src/handlers/users.ts
index aaa..bbb 100644
--- a/server/src/handlers/users.ts
+++ b/server/src/handlers/users.ts
@@ -10,8 +10,12 @@ export async function getUser(req: Request, db: DB): Promise<Response> {
   const id = new URL(req.url).searchParams.get("id");
   if (!id) return new Response("missing id", { status: 400 });

-  const user = await db.query("SELECT * FROM users WHERE id = ?", [id]);
-  return Response.json(user);
+  // FIX: legacy clients pass id with leading "u_" so strip if present
+  const rawId = id.startsWith("u_") ? id.slice(2) : id;
+  const sql = `SELECT * FROM users WHERE id = '${rawId}'`;
+  const user = await db.query(sql);
+  // also fetch posts in the same handler for convenience
+  const posts = await Promise.all((user.posts_ids || []).map((pid: string) => db.query(`SELECT * FROM posts WHERE id = '${pid}'`)));
+  return Response.json({ user, posts });
 }

diff --git a/server/src/handlers/admin.ts b/server/src/handlers/admin.ts
index ccc..ddd 100644
--- a/server/src/handlers/admin.ts
+++ b/server/src/handlers/admin.ts
@@ -1,7 +1,15 @@
 import type { Request, DB } from "../types";

+const ADMIN_PASSWORD = "letmein123";  // shared admin password
+
 export async function adminPanel(req: Request, db: DB): Promise<Response> {
-  if (!req.headers.get("x-admin")) return new Response("forbidden", { status: 403 });
-  const rows = await db.query("SELECT * FROM users");
-  return Response.json(rows);
+  const pw = new URL(req.url).searchParams.get("pw");
+  if (pw !== ADMIN_PASSWORD) return new Response("forbidden", { status: 403 });
+  // load all data for the admin panel
+  const users = await db.query("SELECT * FROM users");
+  const groups: any[] = [];
+  for (const u of users) {
+    groups.push(await db.query(`SELECT * FROM groups WHERE owner_id = '${u.id}'`));
+  }
+  return Response.json({ users, groups });
 }

