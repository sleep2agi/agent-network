FROM oven/bun:1.3.14@sha256:e10577f0db68676a7024391c6e5cb4b879ebd17188ab750cf10024a6d700e5c4
RUN apt-get update && apt-get install -y --no-install-recommends nodejs npm ca-certificates && rm -rf /var/lib/apt/lists/*
RUN mkdir -p /opt/n110 /opt/n121 \
 && npm install --prefix /opt/n110 --omit=optional --no-audit --no-fund @sleep2agi/agent-node@2.5.0-preview.110 \
 && npm install --prefix /opt/n121 --omit=optional --no-audit --no-fund @sleep2agi/agent-node@2.5.0-preview.121
WORKDIR /work/server
COPY server/package.json server/package-lock.json ./
RUN bun install --frozen-lockfile
COPY server/src ./src
COPY server/bin ./bin
COPY tests/node-caller-identity/compat.ts /work/tests/node-caller-identity/compat.ts
COPY tests/node-caller-identity/run-compat.sh /work/tests/node-caller-identity/run-compat.sh
ARG SOURCE_COMMIT
ENV SOURCE_COMMIT=$SOURCE_COMMIT \
    NODE110=/opt/n110/node_modules/@sleep2agi/agent-node/dist/cli.js \
    NODE121=/opt/n121/node_modules/@sleep2agi/agent-node/dist/cli.js
CMD ["bash", "/work/tests/node-caller-identity/run-compat.sh"]
