FROM oven/bun:1.3.14@sha256:e10577f0db68676a7024391c6e5cb4b879ebd17188ab750cf10024a6d700e5c4 AS bun
FROM node:22-bookworm-slim
RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates tmux python3 make g++ && rm -rf /var/lib/apt/lists/*
COPY --from=bun /usr/local/bin/bun /usr/local/bin/bun
WORKDIR /app
COPY server/package.json server/package-lock.json ./server/
RUN cd server && bun install --frozen-lockfile
COPY agent-node/package.json agent-node/package-lock.json ./agent-node/
RUN cd agent-node && bun install --frozen-lockfile
COPY server ./server
COPY agent-node ./agent-node
RUN cd agent-node && bun run build
COPY tests/test658-codex-adopt-stop ./tests/test658-codex-adopt-stop
COPY agent-network/src/stopped-receipt.ts ./agent-network/src/stopped-receipt.ts
COPY deploy/fleet/anet-nodes-boot.sh ./deploy/fleet/anet-nodes-boot.sh
ENV TEST658_CONTAINER=1
USER node
CMD ["bun", "run", "tests/test658-codex-adopt-stop/http-e2e.ts"]
