FROM oven/bun:1.3.14@sha256:e10577f0db68676a7024391c6e5cb4b879ebd17188ab750cf10024a6d700e5c4 AS bun
FROM node:22-bookworm-slim
RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates python3 make g++ procps \
    && rm -rf /var/lib/apt/lists/*
COPY --from=bun /usr/local/bin/bun /root/.bun/bin/bun
ENV PATH="/root/.bun/bin:${PATH}"
WORKDIR /app
COPY server ./server
COPY agent-node ./agent-node
COPY agent-network ./agent-network
RUN cd server && bun install --frozen-lockfile
RUN cd agent-node && bun install --frozen-lockfile && bun run build
# Test-only CLI artifact, never a release or global installation.
RUN cd agent-network && bun install --frozen-lockfile && bun build bin/cli.ts --outfile dist/bin/cli.js --target node --external @sleep2agi/commhub-server --external bun:sqlite
COPY tests/test626-daemon-adoption ./tests/test626-daemon-adoption
CMD ["bun", "/app/tests/test626-daemon-adoption/e2e.ts"]
