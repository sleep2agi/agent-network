FROM oven/bun:latest
# npm audit 端点 2026-09-04 间歇挂起(DEV 实测 4/6 次 20s 超时),npm 自带重试让一个 4s 的 npm link 变 4 分钟;
# 这些镜像里 npm 只负责装依赖,供应链检查另有门(check-supply-chain),关掉 audit/fund 不改变任何判据。
ENV npm_config_audit=false npm_config_fund=false

# Install Node.js
RUN apt-get update && apt-get install -y curl python3 && \
    curl -fsSL https://deb.nodesource.com/setup_20.x | bash - && \
    apt-get install -y nodejs && \
    rm -rf /var/lib/apt/lists/*

# Install from npm registry (preview versions)
RUN npm install -g @sleep2agi/agent-network@preview @sleep2agi/agent-node@preview

# Install commhub-server via bun (it's bun-only)
WORKDIR /app
RUN mkdir -p server && cd server && bun init -y && bun add @sleep2agi/commhub-server@preview

# Copy test script
COPY tests/docker-npm-smoke.sh /app/test.sh
RUN chmod +x /app/test.sh

# Setup anet config
RUN mkdir -p /root/.anet && \
    echo '{"hub":"http://127.0.0.1:9200"}' > /root/.anet/config.json

CMD ["/app/test.sh"]
