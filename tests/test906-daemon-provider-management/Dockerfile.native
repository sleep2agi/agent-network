# TEST-ONLY full application slice. Native Codex; local synthetic HTTPS model.
FROM oven/bun:1.3.14@sha256:e10577f0db68676a7024391c6e5cb4b879ebd17188ab750cf10024a6d700e5c4 AS bun
FROM node:22.22.2-bookworm-slim@sha256:9f6d5975c7dca860947d3915877f85607946403fc55349f39b4bc3688448bb6e
COPY --from=bun /usr/local/bin/bun /usr/local/bin/bun
WORKDIR /work
COPY server/package.json server/package-lock.json ./server/
RUN cd server && npm ci --ignore-scripts --no-audit --no-fund
COPY agent-network/package.json agent-network/package-lock.json ./agent-network/
RUN cd agent-network && npm ci --ignore-scripts --no-audit --no-fund
COPY agent-node/package.json agent-node/package-lock.json ./agent-node/
RUN cd agent-node && npm ci --ignore-scripts --no-audit --no-fund
RUN apt-get update && apt-get install -y --no-install-recommends tmux procps iproute2 openssl ca-certificates curl && rm -rf /var/lib/apt/lists/*
RUN npm install --global --ignore-scripts --no-audit --no-fund @openai/codex@0.159.2
RUN openssl req -x509 -newkey rsa:2048 -nodes -keyout /tmp/fixture-key.pem -out /usr/local/share/ca-certificates/provider906.crt -days 3650 -subj '/CN=localhost' -addext 'subjectAltName=DNS:chatgpt.com,DNS:localhost,IP:127.0.0.1' && chmod 644 /tmp/fixture-key.pem && update-ca-certificates
COPY server ./server
COPY agent-network ./agent-network
COPY agent-node ./agent-node
RUN cd agent-network && bun build bin/cli.ts --target node --outfile dist/bin/cli.js --external @sleep2agi/commhub-server --external bun:sqlite --external '../../server/*'
COPY --chmod=755 agent-network/bin/anet.cjs /work/agent-network/dist/bin/anet.cjs
RUN cd agent-node && npm run build && bun build src/runtime/daemon-provider-snapshot.ts --target node --outfile /work/snapshot-reader.mjs
RUN mkdir -p /opt/test906/node_modules/@sleep2agi/agent-node && cp -r /work/agent-node/dist /work/agent-node/package.json /opt/test906/node_modules/@sleep2agi/agent-node/ && ln -s /work/agent-node/node_modules /opt/test906/node_modules/@sleep2agi/agent-node/node_modules && chmod 755 /opt/test906/node_modules/@sleep2agi/agent-node/dist/cli.js
# Test-only package resolution shim returns the source-built exact package;
# neither Codex, agent-node, lifecycle commands nor Hub handlers are stubbed.
COPY --chmod=755 tests/test906-daemon-provider-management/native-npx.sh /usr/local/bin/npx
COPY --chmod=755 tests/test906-daemon-provider-management/native-tmux.sh /usr/local/bin/tmux
COPY tests/test906-daemon-provider-management/native-application.ts /work/tests/test906-daemon-provider-management/native-application.ts
COPY tests/test906-daemon-provider-management/native-account-fixture.ts /work/tests/test906-daemon-provider-management/native-account-fixture.ts
COPY tests/test906-daemon-provider-management/native-routing-fixture.ts /work/tests/test906-daemon-provider-management/native-routing-fixture.ts
COPY tests/test906-daemon-provider-management/native-reconcile.mjs /work/native-reconcile.mjs
RUN ln -s /usr/local/bin/bun /usr/local/bin/bunx && chmod go-w /work /work/agent-network /work/agent-network/dist /work/agent-network/dist/bin && useradd --create-home --uid 10001 runner
ENV ANET_BIN_ABS=/work/agent-network/dist/bin/anet.cjs ANET_DAEMON_ALLOW_ENV_BIN=1 COMMHUB_DB=/tmp/test906-native.db
USER runner
CMD ["bun", "tests/test906-daemon-provider-management/native-application.ts"]
