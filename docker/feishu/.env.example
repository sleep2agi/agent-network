# Feishu agent — environment template.
# Copy this file to `.env` and fill in the values. The container
# entrypoint reads each variable; any required one missing → fail-fast
# with a clear message.

# ─── Hub (BYOH — your own commhub-server URL + account) ────────────────
# Vincent's path: hub is reachable over the public internet at this URL.
# The container's entrypoint logs in with HUB_USER + HUB_PASSWORD on
# every start (idempotent — the user token is a per-restart artifact;
# no pre-issued ntok_ to manage).
HUB_URL=https://your-hub.example.com
HUB_USER=your-username
HUB_PASSWORD=your-password

# ─── 飞书 App credentials ──────────────────────────────────────────────
# Get from https://open.feishu.cn → your app → "凭证与基础信息".
# The container puts these in .anet/nodes/<alias>/channels/feishu/.env
# at mode 600 (the agent-network channel scaffolding handles permission
# bits — these env vars never get written to disk by the entrypoint
# itself, only the channel-add flag pipeline that goes through
# agent-network's existing access store).
FEISHU_APP_ID=cli_xxxxxxxxxxxxxxxx
FEISHU_APP_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ─── LLM backend (Anthropic-compat vendor) ─────────────────────────────
# `ANET_MODEL` must match what the configured vendor's /v1/messages
# accepts. Verified options as of 2026-06-26:
#   deepseek-v4-pro          → ANTHROPIC_BASE_URL=https://api.deepseek.com/anthropic
#   MiniMax-M3 (vision)      → https://api.minimaxi.com/anthropic
#   MiniMax-M2.7 (text-only) → https://api.minimaxi.com/anthropic
#   claude-sonnet-4-6        → omit ANTHROPIC_BASE_URL (use Anthropic native)
#   intern-s2-preview        → https://chat.intern-ai.org.cn
ANET_MODEL=deepseek-v4-pro
ANTHROPIC_BASE_URL=https://api.deepseek.com/anthropic
ANTHROPIC_AUTH_TOKEN=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ─── Feishu access whitelist (optional but recommended) ────────────────
# Comma-separated. Leave empty to allow any user who can @ the bot.
# - FEISHU_ALLOW_FROM = open_id list (sender-level allow)
# - FEISHU_ALLOW_CHATS = chat_id list (conversation-level allow)
# Get the open_id by having the user send a message to the bot once —
# the agent log line `[feishu] event from=ou_...` carries it.
# FEISHU_ALLOW_FROM=ou_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx,ou_yyyy...
# FEISHU_ALLOW_CHATS=oc_xxxxxxxxxxxxxxxxxxxxxxxx,oc_yyyy...

# ─── Optional tweaks ───────────────────────────────────────────────────
# NODE_ALIAS — alias the hub sees this node by. Default: feishu-agent.
NODE_ALIAS=feishu-agent

# ACK_PLACEHOLDER — emit "⏳ 处理中…" to the user immediately on inbound,
# then edit when the agent's reply lands. Default: true.
ACK_PLACEHOLDER=true
